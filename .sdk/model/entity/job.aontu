# Entity: job

main: kit: entity: job: {

  alias: field: {}

  fields: {
    application_url: {
      fo: "uri"
      h: "Application Url"
      n: "application_url"
      r: false
      sh: "URL to apply for the job"
      t: "`$STRING`"
    }
    company: {
      h: "Company"
      n: "company"
      r: false
      sh: "Company name"
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Detailed job description"
      t: "`$STRING`"
    }
    employment_type: {
      h: "Employment Type"
      n: "employment_type"
      r: false
      sh: "Type of employment"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the job listing"
      t: "`$STRING`"
    }
    industry: {
      h: "Industry"
      n: "industry"
      r: false
      sh: "Industry sector"
      t: "`$STRING`"
    }
    location: {
      h: "Location"
      n: "location"
      r: false
      sh: "Job location"
      t: "`$STRING`"
    }
    posted_date: {
      fo: "date-time"
      h: "Posted Date"
      n: "posted_date"
      r: false
      sh: "Date when the job was posted"
      t: "`$STRING`"
    }
    remote: {
      h: "Remote"
      n: "remote"
      r: false
      sh: "Whether the position is remote"
      t: "`$BOOLEAN`"
    }
    requirements: {
      h: "Requirements"
      n: "requirements"
      r: false
      sh: "List of job requirements and qualifications"
      t: "`$ARRAY`"
    }
    salary: {
      h: "Salary"
      n: "salary"
      r: false
      t: "`$OBJECT`"
    }
    title: {
      h: "Title"
      n: "title"
      r: false
      sh: "Job title"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "job"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /jobs"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "industry"
                or: "industry"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 10
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "location"
                or: "location"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "salary_max"
                or: "salary_max"
                r: false
                t: "`$NUMBER`"
              }
              {
                k: "query"
                n: "salary_min"
                or: "salary_min"
                r: false
                t: "`$NUMBER`"
              }
              {
                k: "query"
                n: "title"
                or: "title"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/jobs"
          q: {
            exist: [
              "industry"
              "limit"
              "location"
              "page"
              "salary_max"
              "salary_min"
              "title"
            ]
          }
          s: [
            {
              lit: "jobs"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
